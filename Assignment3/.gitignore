# macOS
.DS_Store

# Node / React (frontend)
frontend/node_modules/
frontend/build/
frontend/.env
frontend/.env.*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.cache/

# Python / FastAPI (backend)
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.cache/

# Generic caches
**/.cache/

# Model artifacts (large/binary)
backend/models/*.pkl
# Keep model schema file if any
!backend/models/models.py

# Data (optional: un-comment to exclude raw/derived data)
# backend/data/*
# backend/data_model1/*

# IDE/editor
.vscode/
*.code-workspace
.idea/
*.swp
